---
import "@fontsource-variable/inter";
import "@fontsource-variable/montserrat";
import FeedbackWidget from "../components/FeedbackWidget.astro";

interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = "Buck Hub — one trusted place to track every animal you handle, own, or partner on. Join the waitlist.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <slot />

    <FeedbackWidget />

    <!-- PostHog: analytics + waitlist source of truth -->
    <script>
      import posthog from "posthog-js";

      const key = import.meta.env.PUBLIC_POSTHOG_KEY;
      const apiHost =
        import.meta.env.PUBLIC_POSTHOG_HOST || "https://us.i.posthog.com";

      if (key) {
        posthog.init(key, {
          api_host: apiHost,
          person_profiles: "identified_only",
          capture_pageview: false, // we fire `page_viewed` explicitly per naming convention
        });
        // Expose for the waitlist form scripts.
        (window as any).posthog = posthog;
        posthog.capture("page_viewed");
      } else {
        console.warn(
          "[Buck Hub] PUBLIC_POSTHOG_KEY is not set — events will not be sent.",
        );
      }
    </script>

    <style is:global>
      :root {
        /* Buck Hub — Black & Rust palette.
           Old green token NAMES are kept but repointed to the new values so
           existing usages update in one place; conflicting dark-surface roles
           are fixed at their specific call sites. */

        /* Brand */
        --pine: #a05a2c; /* PRIMARY accent (rust) — buttons, eyebrow, links, emphasis */
        --pine-mid: #c06b3a; /* rust hover / light */
        --rust-border: #b0603a;
        --gold: #b5893f; /* secondary accent */
        --sage: #e0b588; /* light accent for on-dark contexts */
        --tan: #b5893f; /* gold (legacy name) */
        --cream: #f4eae0; /* rust tint background (eyebrow pill, soft fills) */
        --rust-tint-border: #e6d4c2;
        --on-rust: #fff8f1;

        /* Dark surfaces */
        --chrome: #12100e; /* dark hero / section bg */
        --footer: #0c0b09;
        --dark-input: #1c1a17;
        --dark-border: #3a362f;
        --on-dark-heading: #fffdfa;
        --on-dark-body: #e8dfd3;
        --on-dark-muted: #a9a199;
        --on-dark-faint: #7b7976;

        /* Light surfaces */
        --paper: #f7f4ef; /* canvas (page bg) */
        --band: #ede9e1; /* alternating band */
        --card: #ffffff;
        --input-fill: #fbf9f5;
        --border: #e4dbcd;

        /* Text on light */
        --ink: #2b2018; /* headings */
        --body: #4a423a; /* body text */
        --ink-muted: #6f6a62; /* muted (legacy name kept) */
        --faint: #9a948b; /* placeholder / faint */

        /* Status */
        --success: #248d5f;

        --pine-soft: rgba(160, 90, 44, 0.1); /* rust tint (focus rings, hovers) */

        --font-serif: "Montserrat Variable", ui-sans-serif, system-ui,
          -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; /* display */
        --font-sans: "Inter Variable", ui-sans-serif, system-ui, -apple-system,
          "Segoe UI", Roboto, Helvetica, Arial, sans-serif;

        /* Type scale — one source of truth so like-elements match everywhere */
        --fs-eyebrow: 0.8rem; /* uppercase pills/labels */
        --fs-small: 0.9rem; /* captions, fineprint, footer, secondary */
        --fs-label: 0.85rem; /* form field labels */
        --fs-body: 1.0625rem; /* base body text (17px) */
        --fs-intro: 1.18rem; /* lead + supporting/section intro paragraphs */
        --fs-card-title: 1.3rem; /* card & panel titles */
        --fs-section: clamp(2rem, 4vw, 2.6rem); /* section headings (h2) */
        --fs-display: clamp(2.4rem, 5.5vw, 3.7rem); /* hero headline (h1) */

        --maxw: 1140px;
        --radius: 14px;
        --shadow: 0 1px 2px rgba(43, 32, 24, 0.06),
          0 12px 32px rgba(43, 32, 24, 0.1);
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background: var(--paper);
        color: var(--body);
        font-family: var(--font-sans);
        font-size: 17px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      h1,
      h2,
      h3 {
        font-family: var(--font-serif);
        font-weight: 800;
        line-height: 1.2;
        letter-spacing: -0.01em;
        color: var(--ink);
        margin: 0;
      }

      p {
        margin: 0;
      }

      a {
        color: inherit;
      }

      img,
      svg {
        max-width: 100%;
        display: block;
      }

      .container {
        max-width: var(--maxw);
        margin: 0 auto;
        padding: 0 24px;
      }

      /* Buttons */
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        font-family: var(--font-sans);
        font-size: 1rem;
        font-weight: 600;
        line-height: 1;
        padding: 0.95rem 1.5rem;
        border-radius: 999px;
        border: 2px solid transparent;
        cursor: pointer;
        text-decoration: none;
        transition:
          transform 0.08s ease,
          background 0.15s ease,
          color 0.15s ease;
      }
      .btn:active {
        transform: translateY(1px);
      }
      .btn-primary {
        background: var(--pine);
        color: var(--paper);
      }
      .btn-primary:hover {
        background: var(--pine-mid);
      }
      .btn-ghost {
        background: transparent;
        color: var(--pine);
        border-color: var(--pine);
      }
      .btn-ghost:hover {
        background: var(--pine-soft);
      }

      .eyebrow {
        display: inline-block;
        font-family: var(--font-sans);
        font-size: var(--fs-eyebrow);
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--pine);
        background: var(--cream);
        padding: 0.45rem 0.9rem;
        border-radius: 1rem;
        line-height: 1.45;
        margin-bottom: 1.35rem;
        text-align: center;
      }

      .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
      }
    </style>
  </body>
</html>
